{
  "name": "40for40-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "astro": "astro",
    "deploy": "astro build && npm run wrangler -- d1 migrations apply 40for40 --remote && npm run wrangler -- deploy",
    "wrangler": "env -u CLOUDFLARE_API_KEY -u CLOUDFLARE_EMAIL wrangler --profile 40for40",
    "types": "wrangler types worker/worker-configuration.d.ts --env-file /dev/null",
    "db:migrate": "npm run wrangler -- d1 migrations apply 40for40 --local"
  },
  "dependencies": {
    "@astrojs/vue": "^7.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "wrangler": "^4.151.3"
  }
}
