{
  "name": "40for40",
  "account_id": "9b4d3e616e55585a0ae844f424717b43",
  "compatibility_date": "2026-10-01",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "40for40",
      "database_id": "e683bf8b-511d-4172-b694-3c2f47b9a8be",
      "migrations_dir": "worker/migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "FORMS",
      "id": "98733a0b3bf3420c953899b74c0f13c8"
    }
  ],
  "routes": [
    { "pattern": "build40for40.com", "custom_domain": true },
    { "pattern": "www.build40for40.com", "custom_domain": true }
  ],
  "workers_dev": true,
  "preview_urls": true
}
