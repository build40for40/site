---
import { Font } from "astro:assets";
import PostHog from "../components/posthog.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "40 for 40: 40 apps in 40 days, built in public",
  description = "40 apps in 40 days, built live with guests who have never vibe coded. Every day stays locked until someone pays to start it. From 2 November 2026.",
} = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en-US" class="scroll-smooth [&:has(dialog[open])]:overflow-hidden">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={url} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="40 for 40" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#ffffff" />
    <Font cssVariable="--font-bricolage" preload />
    <Font cssVariable="--font-plex-mono" />
    <PostHog />
  </head>
  <body class="bg-white font-sans text-ink antialiased">
    <main id="main" class="*:first:border-t-0">
      <slot />
    </main>
  </body>
</html>
