---
import { Font } from "astro:assets";
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "40 for 40: 40 apps in 40 days, built in public",
  description = "40 apps in 40 days, built live with guests who have never vibe coded. Every day stays locked until someone pays to start it. From 2 November 2026.",
} = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en-GB" class="scroll-smooth [&:has(dialog[open])]:overflow-hidden">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={url} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="40 for 40" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#f7f6f2" />
    <Font cssVariable="--font-bricolage" preload />
    <Font cssVariable="--font-plex-mono" preload />
  </head>
  <body class="bg-paper font-sans text-ink antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-full focus:bg-ink focus:px-4 focus:py-2 focus:text-white">Skip to content</a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
