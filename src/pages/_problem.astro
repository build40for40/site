---
import Base from "../layouts/Base.astro";
import FormShell from "../components/forms/FormShell.astro";
import Field from "../components/forms/Field.astro";
---

<Base title="Submit a problem | 40 for 40" description="Got a problem an app could solve? Send it in. It might become one of the 40.">
  <FormShell
    eyebrow="SUBMIT A PROBLEM"
    title="Got a problem? We've got 40 days."
    intro="Tell us what's annoying you in a few sentences. If it makes the cut, we build the fix live and you get to try it first."
    action="/api/forms/problem"
    submit="Send the problem →"
  >
    <Field label="Name" name="name" required autocomplete="name" />
    <Field label="Email" name="email" type="email" required autocomplete="email" />
    <Field label="The problem" name="problem" type="textarea" required maxlength={500} hint="Under 500 characters. Plain words are best." />
    <Field label="Who it affects" name="affects" required hint="You, your mum, every nurse in the NHS..." />
  </FormShell>
</Base>
