---
import Base from "../../layouts/Base.astro";
import NerdsOfFashion from "../../nerds/NerdsOfFashion.vue";

const title = "Nerds of Fashion: a century of trends on one globe";
const description = "Spin through 100 years of Western fashion, see what each place was wearing in any year, and get a guess at what comes back by 2029. Day 9 of 40 for 40.";

const credits = [
  ["Trends, dates and quotes", "Wikipedia contributors", "CC BY-SA 4.0", "https://en.wikipedia.org/wiki/1920s_in_Western_fashion"],
  ["Book curves", "Google Books Ngram Viewer", "CC BY 3.0", "https://books.google.com/ngrams"],
  ["Pictures", "© Victoria and Albert Museum, London", "non-commercial use", "https://collections.vam.ac.uk"],
  ["Coastlines", "Natural Earth", "public domain", "https://www.naturalearthdata.com"],
];
---

<Base title={title} description={description} dark>
  <div class="flex h-svh min-h-[680px] flex-col">
  <header class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-b border-night-line px-4 py-3">
    <h1 class="m-0 text-lg font-bold">Nerds of Fashion <span class="font-normal text-night-muted">· Day 9 of <a href="/" class="text-night-sub">40 for 40</a></span></h1>
    <p class="m-0 hidden text-xs text-night-muted sm:block">A century of what was in, where, and a guess at what comes back.</p>
  </header>

  <section class="min-h-0 flex-1" aria-label="Ask about a century of fashion trends">
    <NerdsOfFashion client:load />
  </section>
  </div>

  <footer class="border-t border-night-line px-4 py-6 text-xs text-night-muted">
    <p class="m-0 max-w-prose">
      This shows what got written about and kept in museums, mostly high fashion, not what everyone wore. The data only names four countries, so the rest of the map is empty until we find more. Forecast years are a model guessing, and it says so.
    </p>
    <ul class="m-0 mt-3 flex list-none flex-wrap gap-x-5 gap-y-1 p-0">
      {credits.map(([what, who, licence, href]) => (
        <li>{what}: <a href={href} class="text-night-sub" target="_blank" rel="noopener">{who}</a> ({licence})</li>
      ))}
    </ul>
  </footer>
</Base>
