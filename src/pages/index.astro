---
import Base from "../layouts/Base.astro";
import DayBoard from "../components/DayBoard.vue";
import JoinForm from "../components/JoinForm.astro";
import SendInPlace from "../components/forms/SendInPlace.astro";
import DevVariants from "../components/DevVariants.astro";
import { history } from "../data/days";
import { links } from "../data/site";

const navLink = "text-night-muted underline-offset-3 hover:text-night-text";
const cta = "rounded-full border px-4 py-2 text-sm font-semibold no-underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-lime";
---

<Base dark>
  <DayBoard client:load history={history} builtAt={Date.now()}>
    <h1 slot="title" class="m-0 flex flex-wrap items-baseline gap-x-4 gap-y-1 text-[clamp(40px,4.4vw,56px)] leading-[0.92] font-bold tracking-[-0.045em]">
      <span role="img" aria-label="40 for 40" class="font-mono font-medium tracking-normal whitespace-nowrap">
        <span class="text-brand-lime">40</span><span class="text-brand-yellow">(</span><span class="text-brand-pink">40</span><span class="text-brand-yellow">)</span>
      </span>
      <span><span class="whitespace-nowrap">40 apps.</span> <span class="whitespace-nowrap">40 days.</span></span>
    </h1>
    <nav slot="links" aria-label="Links" class="flex flex-wrap gap-x-5 gap-y-2 font-mono text-xs">
      <a href={links.twitch} target="_blank" rel="noopener" class={navLink}>Twitch</a>
      <a href={links.community} target="_blank" rel="noopener" class={navLink}>Discord</a>
      <a href={`mailto:${links.email}`} class={navLink}>{links.email}</a>
      <a href="/privacy" class={navLink}>Privacy notice</a>
    </nav>
    <div slot="links" class="flex gap-2">
      <a href="#join" class:list={[cta, "border-brand-lime bg-brand-lime text-brand-lime-ink hover:border-brand-lime-hover hover:bg-brand-lime-hover"]}>I have a problem</a>
      <a href="#browse" aria-controls="browse" aria-expanded="false" class:list={[cta, "border-night-edge text-night-text hover:border-night-text"]}>Browse</a>
    </div>
    <JoinForm slot="join" />
  </DayBoard>
  <SendInPlace />
  {import.meta.env.DEV && <DevVariants />}
</Base>
