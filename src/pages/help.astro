---
import Base from "../layouts/Base.astro";
import FormShell from "../components/forms/FormShell.astro";
import Field from "../components/forms/Field.astro";
import { helpTypes } from "../data/site";
---

<Base title="Help us | 40 for 40" description="Office space, AI credits, guest intros, a CTO for a day or a day sponsorship. Tell us what you can offer.">
  <FormShell
    eyebrow="OFFER HELP"
    title="Help us make it happen."
    intro="Office space is the big one, but credits, intros and spare CTOs are all gratefully received. Five quick fields, no email to write."
    action="/api/forms/help"
    submit="Send it →"
  >
    <Field label="Name" name="name" required autocomplete="name" />
    <Field label="Email" name="email" type="email" required autocomplete="email" />
    <Field label="Company" name="company" autocomplete="organization" />
    <Field label="Type of help" name="type" type="select" required options={helpTypes} />
    <Field label="Short note" name="note" type="textarea" maxlength={1000} hint="Where, what, when. Whatever helps us say yes quickly." />
  </FormShell>
</Base>

<script>
  const type = new URLSearchParams(location.search).get("type");
  const select = document.querySelector<HTMLSelectElement>("#field-type");
  if (type && select?.querySelector(`option[value="${CSS.escape(type)}"]`)) select.value = type;
</script>
