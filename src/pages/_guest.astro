---
import Base from "../layouts/Base.astro";
import FormShell from "../components/forms/FormShell.astro";
import Field from "../components/forms/Field.astro";
import { TOTAL_DAYS } from "../data/site";
import { formatDayDate } from "../data/days";

const weeks = Array.from({ length: Math.ceil(TOTAL_DAYS / 7) }, (_, w) => {
  const first = w * 7 + 1;
  const last = Math.min(first + 6, TOTAL_DAYS);
  return { value: `week-${w + 1}`, label: `Week ${w + 1}`, range: `${formatDayDate(first)} to ${formatDayDate(last)}` };
});
---

<Base title="Be a guest | 40 for 40" description="Spend a day building an app live with the 40 for 40 team. No coding experience needed.">
  <FormShell
    eyebrow="BE A GUEST"
    title="Spend a day building with us."
    intro="Turn up at 9, steer the build, ship an app by 5. Never vibe coded? That's the whole idea. You can also nominate someone else."
    action="/api/forms/guest"
    submit="Count me in →"
  >
    <Field label="Name" name="name" required autocomplete="name" />
    <Field label="Email" name="email" type="email" required autocomplete="email" />
    <Field label="Role" name="role" required hint="Nurse, CEO, student, parent, astronaut. Whatever you'd put on a name badge." />
    <Field label="Nominated by" name="nominated_by" hint="If someone put you up to this, tell us who." />
    <Field label="What you'd bring" name="bring" type="textarea" required maxlength={1000} hint="A problem, a story, a skill, a strong opinion." />
    <fieldset class="m-0 flex flex-col gap-2 border-0 p-0">
      <legend class="mb-1.5 p-0 font-mono text-[11px] font-medium tracking-wide text-muted">AVAILABILITY</legend>
      <div class="grid gap-2 sm:grid-cols-2">
        {weeks.map(({ value, label, range }) => (
          <label class="flex cursor-pointer items-center gap-3 rounded-lg border border-line bg-white px-3.5 py-2.5 has-checked:border-ink">
            <input type="checkbox" name="availability" value={value} class="size-4 accent-ink" />
            <span class="flex flex-col">
              <span class="text-sm font-semibold">{label}</span>
              <span class="font-mono text-[11px] text-muted">{range}</span>
            </span>
          </label>
        ))}
      </div>
    </fieldset>
  </FormShell>
</Base>
