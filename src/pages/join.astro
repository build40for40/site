---
import Base from "../layouts/Base.astro";
import { involvement } from "../data/site";
import SubmitButton from "../components/forms/SubmitButton.astro";
import JoinPool from "../components/JoinPool.vue";

const input =
  "w-full rounded-none border border-ink bg-white px-3 py-2 text-ink outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink";
---

<Base title="Join us | 40 for 40">
  <div class="flex flex-col floor:h-dvh">
    <div class="floor:min-h-0 floor:flex-[2] floor:overflow-y-auto">
      <article class="flex max-w-2xl flex-col gap-10 px-8 py-10 text-xl leading-snug text-pretty md:px-9 md:text-2xl">
        <header class="flex items-start justify-between gap-6">
          <h1 class="text-4xl leading-tight font-semibold tracking-tight md:text-5xl">We’d like to get to know you</h1>
          <a href="/" aria-label="Close and go back" class="-mr-2 shrink-0 px-2 text-4xl leading-tight text-ink hover:opacity-60 md:text-5xl">✕</a>
        </header>

        <form method="post" action="/api/forms/join" class="flex flex-col gap-10 [&_label]:font-semibold">
          <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="hidden" />

          <div class="flex flex-col gap-3">
            <label for="join-email">Email <span aria-hidden="true">*</span></label>
            <p id="join-email-hint">Required, so we can connect and let you know important stuff. Also, we’re GDPR compliant.</p>
            <input id="join-email" name="email" type="email" required maxlength="254" autocomplete="email" aria-describedby="join-email-hint" class={input} />
          </div>

          <div class="flex flex-col gap-3">
            <label for="join-name">Name (Optional)</label>
            <p id="join-name-hint">But helpful for shoutouts and to get to know you.</p>
            <input id="join-name" name="name" type="text" maxlength="200" autocomplete="name" aria-describedby="join-name-hint" class={input} />
          </div>

          <div class="flex flex-col gap-3">
            <label for="join-problem">What’s a problem you want solved? This will help us generate problems to solve during 40 for 40 (Optional)</label>
            <div id="join-problem-hint">
              <p>Heads up: it goes on the site for people to sponsor, with your first name if you gave us one.</p>
              <p>Examples:</p>
              <ol class="list-decimal pl-8">
                <li>I’ve always wanted to know about the stories of the women who helped shaped our world today?</li>
                <li>Is there a way a faster way to write 100 Christmas cards, but it’s still me writing them, not AI and not just printed?</li>
                <li>I just got my nails painted and they chipped the next day.</li>
              </ol>
            </div>
            <textarea id="join-problem" name="problem" rows="4" maxlength="1000" aria-describedby="join-problem-hint" class:list={[input, "resize-y"]}></textarea>
          </div>

          <fieldset class="flex flex-col gap-3">
            <legend class="mb-3 font-semibold">Want to get involved?</legend>
            {involvement.map(({ value, label }) => (
              <div>
                <label class="flex cursor-pointer items-start gap-3 font-normal!">
                  <input
                    type="checkbox"
                    name="involved"
                    value={value}
                    class:list={["mt-1.5 size-5 shrink-0 accent-ink", value === "sponsor" && "motion-safe:checked:animate-pop"]}
                  />
                  <span>{label}</span>
                </label>
              </div>
            ))}
          </fieldset>

          <div class="flex items-center gap-6">
            <SubmitButton class="rounded-none border border-ink bg-ink px-4 py-2 font-semibold text-white hover:bg-white hover:text-ink">Submit</SubmitButton>
            <a href="/" class="underline hover:opacity-60">Back</a>
          </div>
        </form>
      </article>
    </div>
    <JoinPool client:load field="join-problem" class="floor:flex-1" />
  </div>
</Base>

<script>
  const email = new URLSearchParams(location.hash.slice(1)).get("email");
  const field = document.querySelector<HTMLInputElement>("#join-email");
  if (email && field && !field.value) field.value = email;
  if (location.hash) history.replaceState(null, "", location.pathname);

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && !event.defaultPrevented) location.href = "/";
  });
</script>
