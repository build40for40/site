---
const nav = [
  { label: "How it works", href: "/#how" },
  { label: "The 40 days", href: "/#days" },
  { label: "Watch", href: "/#watch" },
];
---

<header class="flex items-center justify-between gap-4 border-b border-line px-4 py-4 md:px-12 md:py-5">
  <a href="/" class="text-xl font-bold tracking-tight text-ink no-underline">40 for 40</a>
  <nav aria-label="Main" class="flex items-center gap-7 font-mono text-xs text-muted">
    {nav.map(({ label, href }) => (
      <a href={href} class="hidden text-muted no-underline hover:text-ink md:inline">{label}</a>
    ))}
    <a href="/#help" class="rounded-full bg-ink px-3.5 py-2 text-white no-underline hover:bg-accent-deep">Help us →</a>
  </nav>
</header>
