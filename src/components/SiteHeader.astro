---
const nav = [
  { label: "40 apps", href: "/apps" },
  { label: "Watch", href: "/watch" },
];
const path = Astro.url.pathname.replace(/\/$/, "");
const current = (href: string) => (path === href || path.startsWith(`${href}/`) ? "page" : undefined);
---

<header class="flex items-center justify-between gap-4 border-b border-line px-4 py-4 md:px-12 md:py-5">
  <a href="/" class="text-xl font-bold tracking-tight text-ink no-underline">40 for 40</a>
  <nav aria-label="Main" class="flex items-center gap-4 font-mono text-xs text-muted sm:gap-7">
    {nav.map(({ label, href }) => (
      <a href={href} aria-current={current(href)} class="text-muted no-underline hover:text-ink aria-[current=page]:text-ink">{label}</a>
    ))}
    <a href="/help" aria-current={current("/help")} class="rounded-full bg-ink px-3.5 py-2 text-white no-underline hover:bg-accent-deep aria-[current=page]:bg-accent-deep">Help us →</a>
  </nav>
</header>
