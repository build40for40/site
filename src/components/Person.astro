---
import { initials } from "../data/site";

interface Props {
  name: string;
  role: string;
  photo?: string;
}

const { name, role, photo } = Astro.props;
const hue = [...name].reduce((sum, char) => sum + char.charCodeAt(0), 0) % 360;
---

<li class="flex flex-col gap-3">
  <div class="relative aspect-4/5 overflow-hidden rounded-md bg-[#ddd]">
    {photo ? (
      <img src={photo} alt={`Photo of ${name}`} loading="lazy" class="absolute inset-0 size-full object-cover" />
    ) : (
      <div
        class="absolute inset-0 flex items-center justify-center bg-[repeating-linear-gradient(135deg,oklch(0.84_0.06_var(--hue))_0_9px,oklch(0.9_0.04_var(--hue))_9px_18px)] text-5xl font-bold tracking-tight text-ink/70"
        style={{ "--hue": hue }}
        aria-hidden="true"
      >
        {initials(name)}
      </div>
    )}
  </div>
  <div class="flex flex-col gap-0.5">
    <div class="text-lg leading-tight font-semibold">{name}</div>
    <div class="font-mono text-xs text-muted">{role}</div>
  </div>
</li>
