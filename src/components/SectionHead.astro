---
interface Props {
  eyebrow: string;
  title: string;
  as?: "h1" | "h2";
}

const { eyebrow, title, as: Heading = "h2" } = Astro.props;
---

<div class="flex flex-col gap-3">
  <div class="font-mono text-xs font-medium tracking-wider text-muted">{eyebrow}</div>
  <Heading class="m-0 text-4xl leading-[0.95] font-bold tracking-tight text-balance md:text-5xl" set:html={title} />
</div>
