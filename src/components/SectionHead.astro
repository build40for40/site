---
interface Props {
  eyebrow: string;
  title: string;
}

const { eyebrow, title } = Astro.props;
---

<div class="flex flex-col gap-3">
  <div class="font-mono text-xs font-medium tracking-wider text-muted">{eyebrow}</div>
  <h2 class="m-0 text-4xl leading-[0.95] font-bold tracking-tight text-balance md:text-5xl" set:html={title} />
</div>
