---
import { companySponsors } from "../data/site";

// A lone sponsor would leave the orbit empty most of the time, so the logos repeat to fill it.
const orbit = Array.from({ length: Math.ceil(3 / companySponsors.length) }, () => companySponsors).flat();

const tiles = [
  "bg-[repeating-linear-gradient(90deg,var(--color-night-sub)_0_7px,var(--color-night-muted)_0_14px,var(--color-night-text)_0_21px,var(--color-night-edge)_0_28px,var(--color-night-sub)_0_35px)]",
  "bg-[repeating-conic-gradient(color-mix(in_oklab,var(--color-night-text)_45%,transparent)_0_25%,transparent_0_50%)] bg-size-[14px_14px]",
  "bg-[repeating-linear-gradient(color-mix(in_oklab,var(--color-night)_35%,transparent)_0_7px,transparent_0_21px)]",
  "bg-[conic-gradient(at_7px_7px,transparent_75%,var(--color-pop-cyan)_0)] bg-size-[35px_28px]",
  "bg-[conic-gradient(at_7px_7px,transparent_75%,var(--color-pop-pink)_0)] bg-size-[70px_21px]",
  "bg-[linear-gradient(90deg,var(--color-night)_1px,transparent_0),linear-gradient(var(--color-night)_1px,transparent_0)] bg-size-[7px_7px]",
];

const glints = [
  { at: "-top-1 left-1", delay: "0s" },
  { at: "top-1/3 -right-1.5", delay: "-0.9s" },
  { at: "bottom-0 left-1/4", delay: "-1.7s" },
];
---

<section aria-labelledby="sponsors-title" class="mx-auto flex w-full max-w-[1600px] items-center gap-4 px-4 pb-8 lg:px-12">
  <h2 id="sponsors-title" class="m-0 shrink-0 font-mono text-[10px] font-medium tracking-wider text-night-muted uppercase">Sponsors</h2>
  <div
    class="group @container relative isolate flex h-20 min-w-0 flex-1 items-center justify-center gap-6 overflow-hidden mask-x-from-80% [--orbit-radius:min(36cqw,18rem)] [--orbit-stretch:2.5] [--orbit-tilt:6px] [--orbit-time:12s] lg:h-24"
  >
    <div aria-hidden="true" class="relative z-1 size-14 shrink-0 lg:size-18">
      <div class="absolute inset-0 overflow-hidden rounded-full bg-night-sub shadow-[0_0_28px_color-mix(in_oklab,var(--color-pop-pink)_35%,transparent)]">
        {tiles.map((tile) => <div class:list={["absolute inset-0 motion-safe:animate-disco group-hover:[animation-play-state:paused]", tile]} />)}
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_32%_28%,var(--color-night-text),transparent_30%),radial-gradient(circle_at_45%_40%,transparent_30%,color-mix(in_oklab,var(--color-night)_90%,transparent)_72%)]" />
      </div>
      {
        glints.map(({ at, delay }) => (
          <span
            style={`animation-delay: ${delay}`}
            class:list={[
              "absolute size-3 scale-0 bg-night-text [clip-path:polygon(50%_0,60%_40%,100%_50%,60%_60%,50%_100%,40%_60%,0_50%,40%_40%)] motion-safe:animate-twinkle motion-reduce:hidden",
              at,
            ]}
          />
        ))
      }
    </div>
    <ul class="m-0 flex list-none items-center gap-8 p-0 motion-safe:absolute motion-safe:inset-0">
      {
        orbit.map((sponsor, i) => {
          const repeat = i >= companySponsors.length;
          return (
            <li
              aria-hidden={repeat ? "true" : undefined}
              style={`animation-delay: calc(var(--orbit-time) * ${-i / orbit.length})`}
              class:list={[
                "flex items-center justify-center motion-safe:absolute motion-safe:top-1/2 motion-safe:left-1/2 motion-safe:size-0 motion-safe:animate-orbit [animation-duration:var(--orbit-time)] group-hover:[animation-play-state:paused] focus-within:animate-none focus-within:translate-x-28 lg:focus-within:translate-x-32",
                repeat && "motion-reduce:hidden",
              ]}
            >
              <a
                href={sponsor.url}
                target="_blank"
                rel="noopener"
                tabindex={repeat ? -1 : undefined}
                class="block shrink-0 rounded-sm opacity-80 hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-lime"
              >
                <img src={sponsor.logo} alt={sponsor.name} width={sponsor.width} height={sponsor.height} class="block h-5 w-auto drop-shadow-[0_0_6px_var(--color-night)] lg:h-7" />
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
