---
import { companySponsors } from "../data/site";

// A lone sponsor would drift past on its own, so each lap repeats the logos to fill the strip.
const lap = Array.from({ length: Math.ceil(6 / companySponsors.length) }, () => companySponsors).flat();
---

<section aria-labelledby="sponsors-title" class="mx-auto flex w-full max-w-[1600px] items-center gap-4 px-4 pb-8 lg:px-12">
  <h2 id="sponsors-title" class="m-0 shrink-0 font-mono text-[10px] font-medium tracking-wider text-night-muted uppercase">Sponsors</h2>
  <div class="@container min-w-0 flex-1 overflow-hidden mask-x-from-90%">
    <div class="flex w-max motion-safe:animate-credits hover:[animation-play-state:paused]">
      {
        [1, 2].map((copy) => (
          <ul aria-hidden={copy === 2 ? "true" : undefined} class="m-0 flex min-w-[100cqw] shrink-0 list-none items-center justify-around gap-16 p-0 px-8 motion-reduce:not-first:hidden">
            {lap.map((sponsor, i) => {
              const repeat = copy === 2 || i >= companySponsors.length;
              return (
                <li aria-hidden={repeat && copy === 1 ? "true" : undefined} class:list={["shrink-0", repeat && "motion-reduce:hidden"]}>
                  <a
                    href={sponsor.url}
                    target="_blank"
                    rel="noopener"
                    tabindex={repeat ? -1 : undefined}
                    class="block rounded-sm opacity-80 hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-lime"
                  >
                    <img src={sponsor.logo} alt={sponsor.name} width={sponsor.width} height={sponsor.height} class="block h-7 w-auto" />
                  </a>
                </li>
              );
            })}
          </ul>
        ))
      }
    </div>
  </div>
</section>
