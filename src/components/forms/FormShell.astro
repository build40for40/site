---
interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  action: string;
  submit: string;
}

const { eyebrow, title, intro, action, submit } = Astro.props;
---

<section class="mx-auto grid max-w-6xl gap-10 px-4 py-12 md:px-12 md:py-18 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.2fr)] lg:gap-16">
  <div class="flex flex-col gap-4">
    <div class="font-mono text-xs font-medium tracking-wider text-accent-deep">{eyebrow}</div>
    <h1 class="m-0 text-5xl leading-[0.95] font-bold tracking-tight text-balance md:text-6xl">{title}</h1>
    <p class="m-0 max-w-md text-[17px] leading-normal text-body text-pretty">{intro}</p>
    <a href="/" class="font-mono text-xs text-muted hover:text-ink">← Back to 40 for 40</a>
  </div>
  <form method="post" action={action} class="flex flex-col gap-5 rounded-[10px] border border-line bg-sheet p-5 md:p-8">
    <slot />
    <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="hidden" />
    <button type="submit" class="mt-2 cursor-pointer self-start rounded-full border-0 bg-accent px-5.5 py-3 text-[15px] font-semibold text-white hover:bg-accent-deep">{submit}</button>
    <p class="m-0 text-xs text-muted">We'll email you a confirmation. Details are only used to follow up, see our <a href="/privacy" class="text-ink hover:text-accent-deep">privacy notice</a>.</p>
  </form>
</section>
