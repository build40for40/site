<script>
  // Forms marked data-sent-message post in the background and swap their fields for that message.
  document.addEventListener("submit", async (event) => {
    const form = event.target;
    if (!(form instanceof HTMLFormElement) || !form.dataset.sentMessage) return;
    event.preventDefault();
    const status = form.querySelector<HTMLElement>("[role=status]");
    const submit = form.querySelector<HTMLButtonElement>("[data-submit]");
    let error = "That didn’t send. Mind trying again?";
    try {
      const response = await fetch(form.action, { method: "POST", body: new FormData(form), redirect: "manual" });
      if (response.type === "opaqueredirect" || response.ok) {
        // A listener can cancel this to show the form was sent some other way.
        if (!form.dispatchEvent(new Event("sent", { cancelable: true }))) return;
        form.dataset.sent = "";
        if (status) status.textContent = form.dataset.sentMessage;
        return;
      }
      error = (await response.text()) || error;
    } catch {}
    if (status) status.textContent = error;
    if (submit) {
      submit.disabled = false;
      submit.ariaBusy = null;
    }
  });
</script>
