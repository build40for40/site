---
import { sponsorAmounts } from "../../data/site";

const delays = ["delay-50", "delay-100", "delay-150", "delay-200", "delay-250", "delay-300", "delay-350", "delay-400"];
---

<div class="invisible grid grid-rows-[0fr] opacity-0 transition-[grid-template-rows,opacity,visibility] duration-300 ease-out group-has-[[value=sponsor]:checked]/involved:visible group-has-[[value=sponsor]:checked]/involved:grid-rows-[1fr] group-has-[[value=sponsor]:checked]/involved:opacity-100 motion-reduce:transition-none">
  <div class="overflow-hidden">
    <div class="flex flex-col gap-3 pt-4 pl-8">
      <p>How much?</p>
      <div role="radiogroup" aria-label="How much?" class="grid grid-cols-2 gap-3 sm:grid-cols-4">
        {sponsorAmounts.map(({ value, label }, i) => (
          <label
            class:list={[
              "translate-y-2 cursor-pointer opacity-0 transition duration-300 ease-out group-has-[[value=sponsor]:checked]/involved:translate-y-0 group-has-[[value=sponsor]:checked]/involved:opacity-100 motion-reduce:transition-none",
              delays[i % delays.length],
            ]}
          >
            <input type="radio" name="sponsor" value={value} class="peer sr-only" />
            <span class="block border border-ink bg-white px-2 py-2 text-center text-xl whitespace-nowrap font-semibold text-ink hover:bg-ink/10 peer-checked:bg-ink peer-checked:text-white peer-checked:hover:bg-ink/85 peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-ink">
              {label}
            </span>
          </label>
        ))}
      </div>
    </div>
  </div>
</div>
