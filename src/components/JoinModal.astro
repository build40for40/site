---
import { involvement } from "../data/site";
import SubmitButton from "./forms/SubmitButton.astro";

const hint = "m-0 text-[15px] leading-snug text-night-sub text-pretty";
const input =
  "w-full border border-night-edge bg-night px-4 py-2.5 text-[15px] text-night-text placeholder:text-night-muted focus-visible:border-night-text focus-visible:outline-none";
---

<dialog
  id="join"
  aria-labelledby="join-title"
  class="m-auto h-dvh max-h-dvh w-full max-w-full overflow-hidden bg-transparent p-0 text-night-text backdrop:bg-night/85 backdrop:transition-opacity backdrop:duration-500 data-folding:backdrop:opacity-0 sm:h-auto sm:max-h-[calc(100dvh-4rem)] sm:w-[min(44rem,calc(100%-2rem))]"
>
  <div
    class="h-full overflow-y-auto border-night-line bg-night-panel sm:h-auto sm:max-h-[calc(100dvh-4rem)] sm:rounded-lg sm:border in-data-folding:overflow-hidden in-data-folding:bg-night-tile in-data-folding:shadow-2xl in-data-folding:ring-2 in-data-folding:ring-night-edge"
  >
    <div class="flex flex-col gap-7 px-4.5 pt-5 pb-8 sm:px-6 sm:pt-6">
      <header class="flex items-start justify-between gap-4">
        <h2 id="join-title" class="m-0 text-[clamp(32px,5vw,44px)] leading-[0.95] font-bold tracking-[-0.04em] text-balance">We’d like to get to know you</h2>
        <form method="dialog">
          <button
            aria-label="Close"
            class="grid size-11 shrink-0 cursor-pointer place-items-center rounded-full border border-night-edge bg-transparent text-night-text hover:border-night-text focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-action"
          >
            <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 fill-none stroke-current stroke-2 [stroke-linecap:round]">
              <path d="M6 6l12 12M18 6 6 18" />
            </svg>
          </button>
        </form>
      </header>

      <form
        method="post"
        action="/api/forms/join"
        data-sent-message="Got it. We’ll be in touch."
        class="flex flex-col gap-7 data-sent:*:not-[[role=status]]:hidden [&_label]:text-[15px] [&_label]:leading-snug [&_label]:font-semibold"
      >
        <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="hidden" />

        <div class="flex flex-col gap-2">
          <label for="join-email">Email <span aria-hidden="true">*</span></label>
          <p id="join-email-hint" class={hint}>Required, so we can connect and let you know important stuff. Also, we’re GDPR compliant.</p>
          <input id="join-email" name="email" type="email" required maxlength="254" autocomplete="email" placeholder="you@example.com" aria-describedby="join-email-hint" class:list={[input, "rounded-full"]} />
        </div>

        <div class="flex flex-col gap-2">
          <label for="join-name">Name (Optional)</label>
          <p id="join-name-hint" class={hint}>But helpful for shoutouts and to get to know you.</p>
          <input id="join-name" name="name" type="text" maxlength="200" autocomplete="name" aria-describedby="join-name-hint" class:list={[input, "rounded-full"]} />
        </div>

        <div class="flex flex-col gap-2">
          <label for="join-problem">What’s a problem you want solved? This will help us generate problems to solve during 40 for 40 (Optional)</label>
          <div id="join-problem-hint" class="flex flex-col gap-2 text-[15px] leading-snug text-night-sub text-pretty">
            <p class="m-0">Heads up: it goes on the site for people to sponsor, with your first name if you gave us one.</p>
            <p class="m-0 font-mono text-[11px] tracking-wider text-night-muted uppercase">Examples</p>
            <ol class="m-0 list-decimal pl-6 marker:font-mono marker:text-night-muted">
              <li>I’ve always wanted to know about the stories of the women who helped shaped our world today?</li>
              <li>Is there a way a faster way to write 100 Christmas cards, but it’s still me writing them, not AI and not just printed?</li>
              <li>I just got my nails painted and they chipped the next day.</li>
            </ol>
          </div>
          <textarea id="join-problem" name="problem" rows="4" maxlength="1000" aria-describedby="join-problem-hint" class:list={[input, "resize-y rounded-lg"]}></textarea>
        </div>

        <fieldset class="m-0 flex flex-col gap-2.5 border-0 p-0">
          <legend class="mb-2.5 p-0 text-[15px] leading-snug font-semibold">Want to get involved?</legend>
          {involvement.map(({ value, label }) => (
            <label class="flex cursor-pointer items-start gap-3 font-normal! text-night-sub hover:text-night-text has-checked:text-night-text">
              <input
                type="checkbox"
                name="involved"
                value={value}
                class:list={["mt-0.5 size-4.5 shrink-0 accent-night-text", value === "sponsor" && "motion-safe:checked:animate-pop"]}
              />
              <span>{label}</span>
            </label>
          ))}
        </fieldset>

        <SubmitButton class="self-start rounded-full border-0 bg-brand-lime text-brand-lime-ink hover:bg-brand-lime-hover px-6 py-3 text-[15px] font-semibold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-action">Submit</SubmitButton>
        <p role="status" class="m-0 text-[19px] leading-[1.4] text-night-text empty:hidden"></p>
      </form>
    </div>
  </div>
</dialog>

<script>
  import { SENT, type Box, type SentProblem } from "../pool/flight";

  const dialog = document.querySelector<HTMLDialogElement>("dialog#join")!;
  const email = dialog.querySelector<HTMLInputElement>("#join-email")!;
  const form = dialog.querySelector<HTMLFormElement>("form[method=post]")!;
  const panel = dialog.firstElementChild as HTMLElement;

  function open(typed?: string | null) {
    if (typed && !email.value) email.value = typed;
    if (!dialog.open) {
      dialog.showModal();
      window.posthog?.capture("join_opened");
    }
    dialog.querySelector<HTMLElement>(email.value ? "#join-name" : "#join-email")?.focus();
  }

  // The Join box saves the email in the background, then carries it into the form.
  document.addEventListener("submit", (event) => {
    const form = event.target;
    if (!(form instanceof HTMLFormElement) || !form.hasAttribute("data-opens-join")) return;
    event.preventDefault();
    const data = new FormData(form);
    fetch(form.action, { method: "POST", body: data, redirect: "manual" }).catch(() => {});
    open(String(data.get("email") ?? "").trim());
  });

  document.addEventListener("click", (event) => {
    const link = event.target instanceof Element && event.target.closest('a[href="#join"]');
    if (!link) return;
    event.preventDefault();
    open();
  });

  dialog.addEventListener("click", (event) => {
    if (event.target === dialog) dialog.close();
  });

  // The form folds itself up into a box the size of a day, which the board then drops into the pool or onto a day.
  const folded = { width: 88, height: 72 };

  async function fold(): Promise<Box> {
    const { left, top, width, height } = panel.getBoundingClientRect();
    const x = folded.width / width;
    const y = folded.height / height;
    dialog.dataset.folding = "";
    const options = { fill: "forwards", easing: "cubic-bezier(.65,0,.35,1)" } as const;
    const steps = [
      panel.firstElementChild!.animate([{ opacity: 1 }, { opacity: 0 }], { ...options, duration: 220 }),
      panel.animate(
        [
          { transform: "none" },
          { transform: `perspective(1200px) rotateX(24deg) scale(0.94, ${Math.max(y, 0.22)})`, offset: 0.45 },
          { transform: `perspective(1200px) rotateY(-24deg) scale(${x * 1.15}, ${y * 1.15})`, offset: 0.82 },
          { transform: `scale(${x}, ${y})` },
        ],
        { ...options, duration: 760 },
      ),
    ];
    await Promise.all(steps.map((step) => step.finished));
    return { left: left + (width - folded.width) / 2, top: top + (height - folded.height) / 2, ...folded };
  }

  function showSent() {
    form.dataset.sent = "";
    const status = form.querySelector<HTMLElement>("[role=status]");
    if (status) status.textContent = form.dataset.sentMessage ?? "";
  }

  form.addEventListener("sent", async (event) => {
    const data = new FormData(form);
    const problem = String(data.get("problem") ?? "").trim();
    if (!problem) return;
    const detail: SentProblem = { problem, name: String(data.get("name") ?? "").trim(), sponsoring: data.getAll("involved").includes("sponsor"), from: null };
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
      dispatchEvent(new CustomEvent(SENT, { detail }));
      return;
    }
    event.preventDefault();
    detail.from = await fold();
    dispatchEvent(new CustomEvent(SENT, { detail }));
    dialog.close();
    for (const animation of panel.getAnimations({ subtree: true })) animation.cancel();
    delete dialog.dataset.folding;
    showSent();
  });

  // Old /join links, and a Join box that posted before this script ran, arrive as /#join&email=…
  function openFromHash() {
    const params = new URLSearchParams(location.hash.slice(1));
    if (!params.has("join")) return;
    history.replaceState(null, "", location.pathname + location.search);
    open(params.get("email"));
  }
  addEventListener("hashchange", openFromHash);
  openFromHash();
</script>
