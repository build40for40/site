---
import DayGrid from "../DayGrid.vue";
import StreamEmbed from "../StreamEmbed.vue";
import { days, topBackers } from "../../data/days";
import { links, money } from "../../data/site";

const leaders = topBackers(days);
---

<section id="days" class="scroll-mt-4 bg-night px-4 pt-12 pb-5 text-night-text md:px-12 md:pt-14">
  <DayGrid client:visible days={days} />
</section>

<section class="mx-4 grid gap-12 py-14 md:mx-12 md:py-16 lg:grid-cols-2">
  <div class="flex flex-col gap-3.5">
    <div class="font-mono text-xs font-medium tracking-wider">TOP BACKERS</div>
    <ol class="m-0 list-none p-0">
      {leaders.map((leader, i) => (
        <li class="grid grid-cols-[28px_minmax(0,1fr)_auto_auto] items-baseline gap-4 border-b border-line py-2">
          <span class="font-mono text-xs font-medium text-muted">{String(i + 1).padStart(2, "0")}</span>
          <span class="truncate text-base font-semibold">{leader.name}</span>
          <span class="font-mono text-[11px] text-faint">{leader.days} {leader.days === 1 ? "day" : "days"}</span>
          <span class="font-mono text-[13px] font-medium">{money(leader.total)}</span>
        </li>
      ))}
    </ol>
    <p class="m-0 text-sm text-body">Unlock or sponsor a day and your name goes on it, or stay anonymous. Your call.</p>
  </div>

  <div id="watch" class="flex scroll-mt-4 flex-col gap-5 rounded-[10px] bg-ink p-6 text-night-text md:p-9">
    <div class="text-4xl leading-[0.98] font-bold tracking-tight md:text-[40px]">Watch it live.</div>
    <p class="m-0 text-[15px] leading-[1.45] text-night-sub text-pretty">9am to 5pm UK, every day from 2 November, on Twitch. Or don't just watch: build along with us in the community.</p>
    <StreamEmbed client:visible />
    <div class="flex flex-wrap gap-3 font-mono text-xs font-medium">
      <a href={links.twitch} rel="noopener" class="rounded-full bg-night-text px-4 py-2.5 text-ink no-underline hover:bg-white">Open Twitch ↗</a>
      <a href={links.community} rel="noopener" class="rounded-full border border-night-muted px-4 py-2.5 text-night-text no-underline hover:border-night-text">Join the community ↗</a>
    </div>
  </div>
</section>
