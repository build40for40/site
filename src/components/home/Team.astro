---
import SectionHead from "../SectionHead.astro";
import Person from "../Person.astro";
import { team } from "../../data/site";
---

<section id="team" class="mx-4 flex scroll-mt-4 flex-col gap-10 border-t border-ink py-14 md:mx-12 md:py-20">
  <SectionHead eyebrow="THE TEAM" title="The three of us." />
  <ul class="m-0 grid list-none grid-cols-2 gap-x-4 gap-y-8 p-0 lg:grid-cols-4">
    {team.map((person) => <Person {...person} />)}
  </ul>
</section>
