---
import SectionHead from "../SectionHead.astro";
import { days, topBackers } from "../../data/days";
import { money } from "../../data/site";

const leaders = topBackers(days);
---

<section id="backers" class="mx-4 grid scroll-mt-4 gap-8 border-t border-ink py-14 md:mx-12 md:py-20 lg:grid-cols-2 lg:gap-12">
  <div class="flex flex-col gap-5">
    <SectionHead eyebrow="SPONSORS AND BACKERS" title="The people<br />paying for the fun." />
    <p class="m-0 max-w-md text-[15px] leading-normal text-body text-pretty">Unlock or sponsor a day and your name goes on it, or stay anonymous. Your call.</p>
    <a href="/help/offer?type=sponsor" class="self-start rounded-full bg-ink px-5.5 py-3 text-[15px] font-semibold text-white no-underline hover:bg-accent-deep">Sponsor a day →</a>
  </div>
  <div class="flex flex-col gap-3.5">
    <div class="font-mono text-xs font-medium tracking-wider">TOP BACKERS</div>
    <ol class="m-0 list-none p-0">
      {leaders.map((leader, i) => (
        <li class="grid grid-cols-[28px_minmax(0,1fr)_auto_auto] items-baseline gap-4 border-b border-line py-2">
          <span class="font-mono text-xs font-medium text-muted">{String(i + 1).padStart(2, "0")}</span>
          <span class="truncate text-base font-semibold">{leader.name}</span>
          <span class="font-mono text-[11px] text-faint">{leader.days} {leader.days === 1 ? "day" : "days"}</span>
          <span class="font-mono text-[13px] font-medium">{money(leader.total)}</span>
        </li>
      ))}
    </ol>
  </div>
</section>
