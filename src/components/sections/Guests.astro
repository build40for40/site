---
import SectionHead from "../SectionHead.astro";
import Person from "../Person.astro";
import { guests } from "../../data/site";
---

<section id="guests" class="mx-4 flex scroll-mt-4 flex-col gap-10 border-t border-ink py-14 md:mx-12 md:py-20">
  <SectionHead as="h1" eyebrow="WHO YOU'LL MEET" title="Special guests.<br />Zero experience required." />
  <ul class="m-0 grid list-none grid-cols-2 gap-x-4 gap-y-8 p-0 lg:grid-cols-4">
    {guests.map((guest) => <Person {...guest} />)}
    <li class="col-span-2 flex flex-col justify-between gap-6 rounded-[10px] bg-hover p-6 lg:col-span-1">
      <div class="flex flex-col gap-3">
        <div class="text-2xl leading-tight font-bold tracking-tight">Could be you.</div>
        <p class="m-0 text-sm leading-[1.45] text-body text-pretty">Never vibe coded? Perfect. Bring a problem, or bring someone who has one.</p>
      </div>
      <div class="flex flex-col gap-2 font-mono text-xs font-medium">
        <a href="/guest" class="rounded-full bg-ink px-4 py-2.5 text-center text-white no-underline hover:bg-accent-deep">Be a guest →</a>
        <a href="/problem" class="rounded-full border border-ink px-4 py-2.5 text-center text-ink no-underline hover:bg-white">Submit a problem →</a>
      </div>
    </li>
  </ul>
</section>
